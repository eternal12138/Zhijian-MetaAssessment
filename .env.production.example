# =============================================================================
# AI 元认知测评系统——生产环境配置模板
# =============================================================================
# 使用方法：
# 1. 在服务器项目根目录复制本文件并命名为 .env.production。
# 2. 替换所有 CHANGE_ME 开头的占位值。
# 3. .env.production 包含真实密钥，不得提交到 Git，也不要发到聊天或截图中。
# 4. 本文件只是模板，Docker Compose 实际读取的是 .env.production。


# =============================================================================
# 一、Docker Compose 与数据目录
# =============================================================================

# Docker Compose 项目名，用于区分容器、网络和卷。
COMPOSE_PROJECT_NAME=metacognition

# 系统正式访问域名，不要包含 https:// 或路径。
PUBLIC_HOST=www.21050411.xyz

# 服务器上的持久化数据目录，保存数据库、录音和导出文件。
DATA_DIR=/srv/metacognition/data

# 数据库和研究数据备份目录。
BACKUP_DIR=/srv/metacognition/backups

# 自动备份保留天数。
BACKUP_RETENTION_DAYS=30


# =============================================================================
# 二、应用基础与 Web 安全
# =============================================================================

# 页面和 API 文档中显示的系统名称。
APP_NAME="知见 AI 元认知测评"

# 当前应用版本号。
APP_VERSION=0.2.0

# 生产环境必须为 false，避免输出调试信息。
APP_DEBUG=false

# 生产环境关闭 /docs、/redoc 和 OpenAPI 文档。
ENABLE_API_DOCS=false

# 禁止互联网用户自行注册，账号由管理员批量创建。
ALLOW_PUBLIC_REGISTRATION=false

# 允许访问后端的前端来源；多个地址使用英文逗号分隔，生产环境必须使用 HTTPS。
CORS_ORIGINS=https://www.21050411.xyz

# 后端允许的 Host；包含公网域名、容器服务名和本机健康检查地址。
TRUSTED_HOSTS=www.21050411.xyz,localhost,127.0.0.1,backend

# 开启 CSP、X-Frame-Options 等安全响应头。
SECURITY_HEADERS_ENABLED=true

# API 限流：生产环境必须启用。认证与普通 API 使用独立计数窗口。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BYPASS_LOCAL_DEBUG=false
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERAL_PER_MINUTE=300

# JWT 和服务端签名主密钥，至少32字符；建议使用 openssl rand -hex 32 生成。
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS


# =============================================================================
# 三、MySQL 数据库
# =============================================================================

# Docker Compose 内部数据库服务名。
DB_HOST=db

# MySQL 默认端口。
DB_PORT=3306

# 系统业务数据库名。
DB_NAME=metacognition_db

# 业务后端使用的最小权限数据库账号，生产环境禁止使用 root。
DB_USER=metacognition_app

# 业务数据库账号密码，请使用独立强密码。
DB_PASSWORD=CHANGE_ME_DATABASE_APP_PASSWORD

# MySQL root 密码，仅用于初始化、迁移和权限配置。
MYSQL_ROOT_PASSWORD=CHANGE_ME_DATABASE_ROOT_PASSWORD

# 单个后端/Worker 进程的数据库连接池大小；2核4GB服务器建议保持5。
DB_POOL_SIZE=5

# 连接池耗尽时可临时增加的连接数。
DB_MAX_OVERFLOW=5

# 数据库连接回收时间（秒），避免长连接被服务端提前关闭。
DB_POOL_RECYCLE_SECONDS=1800
# 是否输出完整 SQL 调试日志。生产环境和日常本地开发均建议保持 false。
DB_ECHO=false


# =============================================================================
# 四、首次部署管理员
# =============================================================================
# 只在数据库中不存在该账号时创建；以后重复部署不会重置其密码。
# 用户名建议只使用字母、数字、点、横线和下划线。
BOOTSTRAP_ADMIN_USERNAME=admin

# 首次创建管理员时必须至少 12 位且不能是 123456。
# 首次部署并确认管理员可以登录后，可以将本项留空；以后部署不会修改已有管理员。
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_STRONG_PASSWORD

# 管理员在页面中显示的姓名。
BOOTSTRAP_ADMIN_NAME=系统管理员


# =============================================================================
# 五、登录会话与暴力破解防护
# =============================================================================

# JWT 签名算法，一般无需修改。
JWT_ALGORITHM=HS256

# 登录令牌有效期，单位为分钟；480表示8小时。
JWT_EXPIRATION_MINUTES=480

# 连续登录失败达到该次数后锁定账号。
LOGIN_MAX_FAILED_ATTEMPTS=8

# 登录失败后的锁定时间，单位为分钟。
LOGIN_LOCKOUT_MINUTES=15


# =============================================================================
# 六、火山方舟大语言模型（LLM）
# =============================================================================
# 用途：测评结束后，由 AnalysisAgent 对权威转录片段进行元认知结构化编码。
# 测评进行中的 ProtocolAgent 仍执行固定实验协议，不会让大模型自由生成主试提示。
# LLM 与下方 ASR 属于不同产品和密钥体系，请分别创建密钥，不要混用。

# 火山方舟 API Key：
# 控制台入口：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# 可以在首次登录后的“系统管理 → 模型服务”页面填写；若在此填写，将作为启动默认值。
LLM_API_KEY=

# 火山方舟 OpenAI 兼容接口根地址；当前代码会自动追加 /chat/completions。
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 火山方舟模型 ID 或推理接入点 ID。
# 可直接填写控制台支持的 Model ID，也可填写 ep- 开头的 Endpoint ID。
# 下方为适合初期结构化分析、成本较低的示例；正式采集前应在控制台确认仍可调用。
LLM_MODEL=doubao-seed-2-0-lite-260215

# 生成随机性。结构化研究编码建议使用较低值，便于复现。
LLM_TEMPERATURE=0.1

# 核采样范围。结构化编码建议保持较低但不要设为0。
LLM_TOP_P=0.8

# 单次请求允许的最大输出 Token；AnalysisAgent 内部还会限制到1800以内。
LLM_MAX_TOKENS=4096

# 是否启用大模型事后分析；false 时只使用规则分析。
# 首次部署先保持 false；管理员在页面保存并完成诊断后再启用。
REPORT_USE_LLM=false

# 大模型单次请求超时时间，单位为秒；超时后系统会回退到规则分析。
REPORT_LLM_TIMEOUT_SECONDS=60

# 是否启用“权威转录 -> AI 高召回候选 -> 人工复核”流程。
# 与旧版 REPORT_USE_LLM 相互独立；模型不得在此阶段输出最终元认知标签。
METACOGNITIVE_EXTRACTION_ENABLED=true
# 抽取器代码版本，会随每个抽取任务固化保存，便于研究追溯。
METACOGNITIVE_EXTRACTOR_VERSION=1.0.0
# 单次候选抽取请求超时与失败重试次数。2 核 4 GB 服务器建议保持默认。
METACOGNITIVE_EXTRACTION_TIMEOUT_SECONDS=60
METACOGNITIVE_EXTRACTION_MAX_RETRIES=2


# =============================================================================
# 七、火山引擎豆包语音识别（权威 ASR）
# =============================================================================
# 用途：测评结束后异步识别服务器保存的完整录音。
# 浏览器实时字幕仅用于现场反馈，不会覆盖服务端权威转录。

# 首次部署使用 disabled，确保尚未配置密钥时系统仍可安全启动。
# 若决定完全通过环境变量配置，可改为 volcengine 并填写下方密钥及公网地址。
ASR_PROVIDER=disabled

# 以下两项只供 OpenAI/Groq 兼容 ASR 使用；火山引擎模式必须留空。
ASR_API_KEY=
ASR_BASE_URL=

# 写入 ASR 任务和转录版本记录的模型标识，应与资源 ID 保持一致。
ASR_MODEL=volc.seedasr.auc

# 识别语言，zh 表示中文。
# 留空：自动识别中英文及主要中文方言；指定语言需使用 zh-CN、en-US 等官方代码。
ASR_LANGUAGE=

# 单次 HTTP 请求超时时间，单位为秒。
ASR_TIMEOUT_SECONDS=300

# 网络故障、限流等可重试错误的最大重试次数。
ASR_MAX_RETRIES=5

# 实验配置版本。模型、热词或识别参数变化时必须修改该值。
ASR_CONFIG_VERSION=volc-seedasr-auc-2026-07

# ASR Worker 空闲时扫描数据库任务的间隔，单位为秒。
ASR_POLL_INTERVAL_SECONDS=2

# 火山引擎读取录音时使用的公网 HTTPS 根地址。
ASR_PUBLIC_BASE_URL=https://www.21050411.xyz

# 音频临时下载地址的 HMAC 签名密钥，至少32字符，并且不要与 SECRET_KEY 共用。
# 页面选择 volcengine 时会自动生成；若使用环境变量配置，请填至少32字符的独立随机值。
ASR_AUDIO_SIGNING_SECRET=

# 火山引擎音频临时下载地址有效期，单位为秒；600表示10分钟。
ASR_AUDIO_URL_TTL_SECONDS=600

# 新版豆包语音控制台创建的 API Key。
# 可以在“系统管理 → 模型服务”页面填写。
VOLCENGINE_ASR_API_KEY=

# 鉴权模式：api_key=新版控制台；legacy=旧版 App ID + Access Token；auto=兼容旧配置。
# 管理员页面保存后会写入明确模式。
VOLCENGINE_ASR_AUTH_MODE=auto

# 旧版控制台才需要 App ID 和 Access Token；使用新版 API Key 时保持为空。
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_KEY=

# 录音文件识别2.0资源 ID，必须以火山引擎控制台实际开通结果为准。
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.auc

# 标准版异步识别任务提交接口，一般无需修改。
VOLCENGINE_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit

# 标准版异步识别结果查询接口，一般无需修改。
VOLCENGINE_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query

# 提交成功后查询识别结果的间隔，单位为秒。
VOLCENGINE_ASR_QUERY_INTERVAL_SECONDS=3

# 单个录音识别任务最长等待时间，单位为秒。
VOLCENGINE_ASR_MAX_WAIT_SECONDS=600


# =============================================================================
# 八、音频、上传和研究数据导出
# =============================================================================

# 容器内 FFmpeg 命令名称；Docker 镜像已经安装，一般无需修改。
FFMPEG_PATH=ffmpeg

# 容器内录音持久化目录，必须与 compose.yaml 的数据卷路径一致。
AUDIO_UPLOAD_DIR=/data/audio

# 单个浏览器音频分片最大字节数；8388608表示8 MiB。
AUDIO_CHUNK_MAX_BYTES=8388608

# 容器内研究数据导出目录，必须与 compose.yaml 的数据卷路径一致。
RESEARCH_EXPORT_DIR=/data/exports
MODEL_TRAINING_DIR=/data/models

# Qwen 文本嵌入优先在管理员“模型服务状态”页面加密配置。
# 以下变量仅作为首次部署或数据库配置不可用时的回退，真实密钥不要提交到代码仓库。
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_EMBEDDING_BATCH_SIZE=20
QWEN_EMBEDDING_TIMEOUT_SECONDS=60

# 通用远程文本向量服务。留空的地址、密钥、模型会兼容使用上面的 Qwen 配置。
# 仅发送 clean_text，不会发送姓名、账号、user_id、audio_id 等身份信息。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_VERSION=default
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZED=true
EMBEDDING_INSTRUCTION=
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_RETRIES=4

# 当前 TF-IDF Macro-F1 较低，默认不自动降级；仅在人工验收模型后开启。
EMBEDDING_FALLBACK_ENABLED=false
TFIDF_FALLBACK_MODEL_PATH=
# 生成导出包后仍需保留的最小磁盘空间（默认 1 GiB）
RESEARCH_EXPORT_MIN_FREE_BYTES=1073741824


# =============================================================================
# 九、Cloudflare Tunnel（可选）
# =============================================================================
# 仅在使用 compose 的 tunnel profile 时填写。
# Token 属于高敏感凭据，不要把真实值写入本模板或提交到 Git。
CLOUDFLARE_TUNNEL_TOKEN=
