# 阿里云百炼华北2（北京）地域API Key。真实密钥不得提交到代码仓库。
DASHSCOPE_API_KEY=

# 将 WorkspaceId 替换为百炼业务空间的真实ID。
QWEN_EMBEDDING_BASE_URL=https://CHANGE_ME_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 研究协议固定模型。变更模型必须生成新的向量与训练版本。
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# 第一版使用1024维；可选256、512、768、1024、1536、2048、2560。
QWEN_EMBEDDING_DIMENSIONS=1024

# 官方单次最多20条，本项目按20条调用。
QWEN_EMBEDDING_BATCH_SIZE=20
QWEN_EMBEDDING_TIMEOUT_SECONDS=60
QWEN_EMBEDDING_MAX_RETRIES=5
