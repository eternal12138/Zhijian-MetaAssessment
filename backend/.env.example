# ============================================================
# 环境变量配置模板
# 复制为 .env 并填写实际值
# ============================================================

# 应用
APP_NAME="知见 AI 元认知测评"
APP_VERSION="0.2.0"
APP_DEBUG=true
ENABLE_API_DOCS=true
ALLOW_PUBLIC_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
# 本机调试时跳过 API 滑动窗口限流；只有 APP_DEBUG=true 且请求来自 127.0.0.1/::1 时生效。
RATE_LIMIT_BYPASS_LOCAL_DEBUG=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERAL_PER_MINUTE=300
SECRET_KEY=change-me-to-a-random-secret-key

# MySQL 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=metacognition_db

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# AI / LLM (豆包 / OpenAI 兼容)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=ep-2024-your-model-id
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.01
LLM_MAX_TOKENS=4096
REPORT_USE_LLM=true
REPORT_LLM_TIMEOUT_SECONDS=20
METACOGNITIVE_EXTRACTION_ENABLED=true
METACOGNITIVE_EXTRACTOR_VERSION=1.0.0
METACOGNITIVE_EXTRACTION_TIMEOUT_SECONDS=60
METACOGNITIVE_EXTRACTION_MAX_RETRIES=2

# 服务端权威 ASR
# disabled: 只创建任务，不启动识别；openai_compatible/whisper: 调用兼容接口
ASR_PROVIDER=disabled
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=180
ASR_MAX_RETRIES=3
ASR_CONFIG_VERSION=2026.1
ASR_POLL_INTERVAL_SECONDS=2
ASR_PUBLIC_BASE_URL=
ASR_AUDIO_SIGNING_SECRET=
ASR_AUDIO_URL_TTL_SECONDS=600
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_AUTH_MODE=auto
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.auc
VOLCENGINE_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLCENGINE_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
VOLCENGINE_ASR_QUERY_INTERVAL_SECONDS=3
VOLCENGINE_ASR_MAX_WAIT_SECONDS=600
FFMPEG_PATH=ffmpeg
AUDIO_UPLOAD_DIR=uploads/audio
AUDIO_CHUNK_MAX_BYTES=8388608
RESEARCH_EXPORT_DIR=exports/research
MODEL_TRAINING_DIR=models/training
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_EMBEDDING_BATCH_SIZE=20
QWEN_EMBEDDING_TIMEOUT_SECONDS=60
